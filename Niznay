from dataclasses import dataclass


@dataclass
class User:
    login: str
    password: str
    name: str
    grades: list[int]


users = [
    User(
        login="anna",
        password="anna123",
        name="Анна Коваленко",
        grades=[12, 10, 9, 8, 6, 5, 4, 3]
    ),
    User(
        login="bogdan",
        password="bogdan123",
        name="Богдан Мельник",
        grades=[11, 10, 7, 6, 5, 5, 4, 2]
    ),
    User(
        login="viktoria",
        password="viktoria123",
        name="Вікторія Шевченко",
        grades=[12, 12, 11, 9, 8, 7, 6, 5]
    ),
    User(
        login="dmytro",
        password="dmytro123",
        name="Дмитро Бондар",
        grades=[10, 9, 8, 7, 4, 3, 2, 1]
    )
]


def find_user(login, password):
    for user in users:
        if user.login == login and user.password == password:
            return user

    return None


def show_grades(user):
    satisfactory = 0
    unsatisfactory = 0

    for grade in user.grades:
        if 5 <= grade <= 12:
            satisfactory += 1
        elif 1 <= grade <= 4:
            unsatisfactory += 1

    print("\n===================================")
    print(f"Користувач: {user.name}")
    print(f"Логін: {user.login}")
    print(f"Усі оцінки: {user.grades}")
    print(f"Оцінок від 5 до 12: {satisfactory}")
    print(f"Оцінок від 1 до 4: {unsatisfactory}")
    print("===================================")


print("=== Перегляд оцінок ===")

login = input("Введіть логін: ")
password = input("Введіть пароль: ")

current_user = find_user(login, password)

if current_user is not None:
    show_grades(current_user)
else:
    print("\nПомилка: неправильний логін або пароль.")